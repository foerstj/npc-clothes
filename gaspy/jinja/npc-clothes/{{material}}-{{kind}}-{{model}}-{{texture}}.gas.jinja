{% set mat = material[:2] %}
[t:template,n:bd_{{ mat }}_{{ stance }}_{{ kind }}_{{ model }}_{{ texture }}]
{
	specializes = base_body_armor_{{ material }};

	category_name = "amr_body_{{ material }}";
	[common]
	{
	  b allow_modifiers = {{ allow_modifiers }};
		screen_name = "{{ name }}";
	}
	[defend]
	{
		armor_style = {{ texture }};
		armor_type = {{ model }};
		{% if defense != '' %}
	  f defense = {{ defense | float }};
		{% endif %}
	}
	[gui]
	{
		inventory_height = 2;
		inventory_width = 2;
		inventory_icon = b_gui_ig_i_a_pos_{{ model }}_{{ texture }}_nc;
		{% if strength or dexterity or intelligence %}
		{% set reqs_dict = {'strength': strength, 'dexterity': dexterity, 'intelligence': intelligence} %}
		{% set reqs_list = [k ~ ':' ~ v for k, v in reqs_dict.items() if v] %}
		equip_requirements = {{ reqs_list | join(',') }};
		{% endif %}
	}
}
