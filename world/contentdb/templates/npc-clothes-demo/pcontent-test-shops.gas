[t:template,n:base_npc_clothes_pcontent_test_merchant]
{
	specializes = base_npc_bk;

	category_name = "1W_shopkeep";
	doc = "merchant";

	[actor]	{portrait_icon = b_gui_ig_i_ic_c_shopkeep;}
	[aspect]
	{
		use_range = 1.0;
		is_ghost_usable = TRUE;
		draw_selection_indicator = TRUE;
	}
	[conversation]
	{
	}
	[inventory]
	{
	}
	[respawn_shrine]
	{
	}
	[store]
	{
		item_markup = 2;
	}
	[mind]
	{
		jat_talk = world\ai\jobs\common\job_talk.skrit;
	}
}

